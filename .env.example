# --- Model access (pick one) -------------------------------------------
GOOGLE_API_KEY=your-gemini-api-key
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Models per role -------------------------------------------------------
# Spec formats (join with | for a fallback chain):
#   gemini-3.5-flash                         native Gemini (API key or Vertex)
#   openai/gpt-4.1                           OpenAI
#   azure/<deployment-name>                  Azure OpenAI
#   truefoundry/<provider-account>/<model>   TrueFoundry AI Gateway (e.g. truefoundry/azure-openai-main/gpt-4o)
#   openai_compatible/<model>                any OpenAI-compatible server (vLLM, LM Studio, LiteLLM proxy...)
#   anthropic/..., bedrock/..., ollama_chat/...  anything LiteLLM supports
AGENT_MODEL=gemini-3.5-flash
PLANNER_MODEL=gemini-3.1-pro
CRITIC_MODEL=gemini-3.5-flash
LEARNER_MODEL=gemini-3.5-flash
SUMMARIZER_MODEL=gemini-3.5-flash
# Example: Azure first, then the same model through TrueFoundry, then Gemini
# AGENT_MODEL=azure/gpt-4o-prod|truefoundry/azure-openai-main/gpt-4o|gemini-3.5-flash

# --- Reasoning per role: off | auto | minimal | low | medium | high ---------
PLANNER_REASONING=auto
AGENT_REASONING=auto
CRITIC_REASONING=off
PLAN_REACT_FALLBACK=true          # prompted plan->act for a non-reasoning synthesizer
PROMPT_CACHE_HINTS=true           # prompt_cache_key (OpenAI/Azure/TrueFoundry), cache_control (Anthropic)

# --- Web search -------------------------------------------------------------
SEARCH_PROVIDER=auto              # auto | gemini | tavily | exa | brave | openai | none
# SEARCH_MODEL=gemini-3.5-flash   # gemini: Google Search grounding; or openai/gpt-4o-search-preview
# TAVILY_API_KEY=tvly-...
# EXA_API_KEY=...
# BRAVE_API_KEY=...
SEARCH_MAX_RESULTS=5

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=                 # optional, e.g. an OpenAI proxy

# Azure OpenAI
# AZURE_API_KEY=...
# AZURE_API_BASE=https://<resource>.openai.azure.com
# AZURE_API_VERSION=2024-10-21

# TrueFoundry AI Gateway
# TFY_BASE_URL=https://<org>.truefoundry.cloud    # gateway = $TFY_BASE_URL/api/llm
# TFY_GATEWAY_URL=                                # or set the full gateway URL directly
# TFY_API_KEY=<personal or virtual access token>
# TFY_EXTRA_HEADERS={"X-TFY-METADATA": "{\"app\":\"procedural-agent\"}"}

# Any OpenAI-compatible endpoint
# OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPAT_API_KEY=none

# --- Memory backends ---------------------------------------------------
AGENT_DATA_DIR=.data
MEMORY_BACKEND=sqlite            # sqlite | vertex
# GOOGLE_CLOUD_AGENT_ENGINE_ID=  # needed for MEMORY_BACKEND=vertex
# ARTIFACT_BUCKET=               # needed for MEMORY_BACKEND=vertex

# --- Harness ---------------------------------------------------------------
MAX_REVISIONS=2
MAX_REPLANS=1
ACCEPT_SCORE=0.75
MAX_LLM_CALLS_PER_TURN=40
LEARNING_ENABLED=true
LEARNER_MODE=llm                 # llm | heuristic
PROMOTE_AFTER=3
DEPRECATE_BELOW=0.35
COMPACTION_INTERVAL=6
CONTEXT_CACHE=true

# --- Data sources ------------------------------------------------------
HTTP_ALLOWLIST=api.open-meteo.com,geocoding-api.open-meteo.com,air-quality-api.open-meteo.com,api.frankfurter.app,earthquake.usgs.gov,api.coingecko.com
# MCP servers: mcp_servers.json (see packs/techintel/mcp_servers.json.example) or inline:
# MCP_SERVERS=[{"name":"crm","url":"https://your-host/mcp","headers":{"Authorization":"Bearer ${CRM_TOKEN}"}}]
# MCP_SERVERS_FILE=mcp_servers.json
# LLM_STEP_MODEL=gemini-3.5-flash     # model for LLM: procedure steps (defaults to LEARNER_MODEL)
# APPROVAL_TTL_HOURS=24
# APPROVALS_POLICY_FILE=approvals_policy.json   # standing approvals for scheduled writes

# Mail MCP server (packs/mail/mail_mcp.py)
# MAIL_PROVIDER=auto            # graph | smtp | auto
# MAIL_FROM=intel@yashodhantek.com
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_DRY_RUN=1                # write emails to MAIL_OUTBOX_DIR instead of sending
# MAIL_OUTBOX_DIR=.data/outbox

# Signal (techintel) pack
# TECHINTEL_URL=https://intel.yashodhantek.com
# TECHINTEL_EMAIL=
# TECHINTEL_PASSWORD=
# TECHINTEL_BRIEF_DIR=~/techintel-briefs

# --- Observability / security --------------------------------------------
# ADK_LOGGING=1
# ENABLE_TRACING=1
# TOOL_CALL_HMAC_KEY=change-me
